# ============================================
# PADDLE BILLING (Supabase Edge Function secrets)
# ============================================
# Set these as Supabase Edge Function secrets via:
#   supabase secrets set PADDLE_API_KEY=your_paddle_api_key
#
# PADDLE_API_KEY=pdl_xxx                  — Paddle API key (live or sandbox)
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx    — Paddle notification webhook secret
# PADDLE_ENVIRONMENT=sandbox              — 'sandbox' or 'production'
# APP_URL=https://www.brainsheist.com     — Post-checkout redirect base URL
#
# Paddle Price IDs (create in Paddle dashboard → Catalog → Prices):
# PADDLE_PRICE_CORE_MONTHLY=pri_xxx       — Core plan, monthly ($449)
# PADDLE_PRICE_CORE_YEARLY=pri_xxx        — Core plan, yearly ($4,490)
# PADDLE_PRICE_STANDARD_MONTHLY=pri_xxx   — Standard plan, monthly ($649)
# PADDLE_PRICE_STANDARD_YEARLY=pri_xxx    — Standard plan, yearly ($6,490)
# PADDLE_PRICE_PRO_MONTHLY=pri_xxx        — Pro plan, monthly ($1,149)
# PADDLE_PRICE_PRO_YEARLY=pri_xxx         — Pro plan, yearly ($11,490)
#
# Legacy Stripe (kept for backward compat, no longer primary):
# STRIPE_SECRET_KEY=sk_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_CORE_MONTHLY=price_xxx
# STRIPE_PRICE_CORE_YEARLY=price_xxx
# STRIPE_PRICE_STANDARD_MONTHLY=price_xxx
# STRIPE_PRICE_STANDARD_YEARLY=price_xxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_YEARLY=price_xxx

# Gemini API Key (if integrating AI features)
# GEMINI_API_KEY=your_api_key_here

# Feature Flags
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_MULTIPLAYER=true

# Game Configuration
# VITE_STARTING_COINS=1000
# VITE_STARTING_LEVEL=1
# VITE_MAX_DAILY_XP=1000
