# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# SUPABASE CONFIGURATION (Required for backend)
# ============================================
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================
# LEGACY API CONFIGURATION (Not needed for Supabase)
# ============================================
# VITE_API_URL=http://localhost:3000/api

# Gemini API Key (if integrating AI features)
# GEMINI_API_KEY=your_api_key_here

# Feature Flags
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_MULTIPLAYER=true

# Game Configuration
# VITE_STARTING_COINS=1000
# VITE_STARTING_LEVEL=1
# VITE_MAX_DAILY_XP=1000

