{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brains Heist Admission Curriculum Map",
  "type": "object",
  "required": ["map_id", "map_version", "locked", "grade_stage_mapping", "objectives"],
  "properties": {
    "map_id": { "type": "string", "minLength": 1 },
    "map_version": { "type": "string", "minLength": 1 },
    "locked": { "const": true },
    "curriculum_authority": { "enum": ["brain_heist", "cambridge"] },
    "programme": { "enum": ["brain_heist_international", "Cambridge Primary", "Cambridge Lower Secondary", "Cambridge IGCSE", "cambridge_igcse"] },
    "assessment_style": { "enum": ["international_school_admission"] },
    "official_affiliation": { "enum": ["none", "cambridge_linked"] },
    "reference_frameworks": {
      "type": "array",
      "items": { "enum": ["CEFR", "England National Curriculum", "Common Core", "NGSS", "other reviewed public national or international standards"] }
    },
    "source_references": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_licences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "copyright_policy": { "enum": ["original_questions_only"] },
    "source_review_status": { "type": "string" },
    "academic_review_status": { "type": "string" },
    "grade_stage_mapping": {
      "type": "object",
      "required": ["explicit", "school_grade", "programme"],
      "properties": {
        "explicit": { "const": true },
        "school_grade": { "type": "integer", "minimum": 1, "maximum": 10 },
        "programme": { "type": "string" },
        "cambridge_stage": { "type": ["integer", "string"] },
        "level_definition": { "type": "string" },
        "rationale": { "type": "string" },
        "reviewer": { "type": "string" },
        "date": { "type": "string" }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["school_grade", "programme", "typical_age_min", "typical_age_max", "subject", "objective_id", "strand", "subskill", "learner_can", "prerequisites", "prohibited_extensions", "allowed_question_types", "allowed_difficulties", "allowed_cognitive_levels"],
        "properties": {
          "school_grade": { "type": "integer" },
          "programme": { "type": "string" },
          "cambridge_stage": { "type": ["integer", "string"] },
          "typical_age_min": { "type": "integer" },
          "typical_age_max": { "type": "integer" },
          "subject": { "enum": ["english", "maths", "science"] },
          "subject_code": { "type": "string" },
          "source_version": { "type": "string" },
          "source_status": { "type": "string" },
          "objective_id": { "type": "string" },
          "strand": { "type": "string" },
          "subskill": { "type": "string" },
          "learner_can": { "type": "string" },
          "level_definition": { "type": "string" },
          "prerequisite_definition": { "type": "string" },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "prohibited_extensions": { "type": "array", "items": { "type": "string" } },
          "allowed_question_types": { "type": "array", "items": { "type": "string" } },
          "allowed_difficulties": { "type": "array", "items": { "type": "string" } },
          "allowed_cognitive_levels": { "type": "array", "items": { "type": "string" } },
          "source_reference": { "type": "string" },
          "source_references": { "type": "array", "items": { "type": "string" } },
          "review_status": { "type": "string" },
          "source_review_status": { "type": "string" },
          "academic_review_status": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "programme": { "const": "brain_heist_international" } } },
      "then": { "required": ["curriculum_authority", "assessment_style", "official_affiliation", "reference_frameworks", "source_references", "source_licences", "copyright_policy", "source_review_status", "academic_review_status"] }
    }
  ]
}
