{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-tests",
    "types": [
      "node",
      "vite/client"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "esModuleInterop": true
  },
  "include": [
    "tests/**/*.ts",
    "src/features/lockdown/**/*.ts",
    "src/features/onboarding/**/*.ts",
    "src/lib/**/*.ts",
    "components/admissionReportPartialAttempt.ts",
    "services/rpcGateway.ts",
    "services/admissionService.ts",
    "services/supabaseClient.ts",
    "services/env.ts",
    "services/ieltsExamModeService.ts",
    "services/ieltsExamModeUx.ts",
    "services/ieltsExamPayloadParser.ts",
    "services/ieltsExamAccessService.ts",
    "services/ieltsExtraPracticeAccessService.ts",
    "services/ieltsPracticeAssignmentService.ts",
    "services/ieltsJourneyService.ts",
    "services/ieltsResultsService.ts",
    "services/ieltsSchoolStudentSnapshotService.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
