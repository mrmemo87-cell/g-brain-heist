     "end": 39.56662131519275
    },
    {
     "kind": "speech",
     "segment": "F-01",
     "speaker": "Coordinator",
     "voice": "Miriam",
     "start": 39.56662131519274,
     "end": 87.63192743764172,
     "text": "Here are the final details for the science demonstration. Equipment will arrive at two forty-five, but the demonstration itself begins at three fifteen in the afternoon. Your coordinator is Mr Nevin, spelled N-E-V-I-N. Collect your equipment from desk twenty-four. Desk twenty-six handles visitor registration, so please do not queue there. Bring a charger for your laptop; we cannot lend you one. We planned a demonstration about wind turbines, but the kit has not arrived. The demonstration will instead be about solar ovens. It will take place in the courtyard. The laboratory is being cleaned.",
     "source_mp3_sha256": "15ae3c8bfd1c4bc9cccf42999df812c0b7dc82a63166aacb5e65e9e3e21102ba",
     "provider_task_id": "a63bc3f2-82f6-4ad8-992c-c1e2e9b0645a"
