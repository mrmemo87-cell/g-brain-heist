   "cues": [
    {
     "kind": "instructions",
     "start": 0,
     "end": 9.566621315192744,
     "text": "This recording is copyright Brains Heist LLC. All rights reserved. Read questions F1 to F6 and check the word limits.",
     "voice": "Tom",
     "provider_task_id": "36e454ca-9b3d-446f-a91a-577331aa8a7b",
     "source_mp3_sha256": "b975bb4fe37912dcd8b0862248de10c8e53b551fdee73766187c9eeb2e79eacc"
    },
    {
     "kind": "reading_silence",
