   "cues": [
    {
     "kind": "instructions",
     "start": 0,
     "end": 10.448979591836734,
     "text": "This recording is copyright Brains Heist LLC. All rights reserved. Read questions B1 to B4 and check the word limits.",
     "voice": "Tom",
     "provider_task_id": "1d49b0aa-8099-4cf2-b338-a64c2687d875",
     "source_mp3_sha256": "2f003842774b9d6e8424a64453eb1a8d47e08ceb62ef9030d6f63dcb554fd95a"
    },
    {
     "kind": "reading_silence",
     "start": 10.448979591836734,
     "end": 40.44897959183673
    },
    {
     "kind": "speech",
     "segment": "B-01",
     "speaker": "Student",
     "voice": "James",
     "start": 40.44897959183673,
     "end": 42.63165532879819,
     "text": "I'm calling about our media room booking.",
     "source_mp3_sha256": "fb9f4a7da0ccd91d9ebf01583a714667e532e4174fb1fdd58ec7229e98277c1a",
     "provider_task_id": "8b6a4929-e3ba-4ef2-b654-51e02dbc65ab"
    },
    {
     "kind": "speech",
     "segment": "B-02",
     "speaker": "Assistant",
     "voice": "Paula",
     "start": 42.981632653061226,
     "end": 49.808299319727894,
     "text": "Yes. You'll use room three eighteen. Room three thirteen is being used for a staff meeting.",
     "source_mp3_sha256": "891f2e87d34ec4f96f754fd5d5fc01708ba637a149ee167fd957eb298bd4dab0",
     "provider_task_id": "b617feab-df05-42b3-822b-c72234d91e9d"
    },
    {
     "kind": "speech",
     "segment": "B-03",
     "speaker": "Student",
     "voice": "James",
     "start": 50.15827664399093,
     "end": 51.78367346938776,
     "text": "Will Mr Palmer supervise us?",
     "source_mp3_sha256": "663ae5c3413fec04e8291cab49869945d11640226db9c1ad901658d3243320a7",
     "provider_task_id": "25bbe077-185b-424d-b45b-a870664b3239"
    },
    {
     "kind": "speech",
     "segment": "B-04",
     "speaker": "Assistant",
     "voice": "Paula",
     "start": 52.133650793650794,
     "end": 57.42780045351474,
     "text": "He cannot come that day. Ms Vale will supervise. Her surname is V-A-L-E.",
     "source_mp3_sha256": "b67fe8507b1659cef17e6f80386715eb520d7ad2f599a5778ba471a8f9ab38e1",
     "provider_task_id": "ff694913-bc35-4b19-a973-cb5a7e640788"
    },
    {
     "kind": "speech",
     "segment": "B-05",
     "speaker": "Student",
     "voice": "James",
     "start": 57.77777777777778,
     "end": 60.982131519274375,
     "text": "I requested fifty minutes. Has that been confirmed?",
     "source_mp3_sha256": "6cc211136533f95c2bcb5fcfcc08e8ebf9448b7493e72a3990227fac5b68ad62",
     "provider_task_id": "dc2f0498-5e71-4ea2-adbb-e682a652cbf8"
    },
    {
     "kind": "speech",
     "segment": "B-06",
     "speaker": "Assistant",
     "voice": "Paula",
     "start": 61.33210884353741,
     "end": 67.3692970521542,
     "text": "We've only been able to reserve thirty-five minutes. Another group needs the room after that.",
     "source_mp3_sha256": "dbfee260495ddb8a7575402dbc2117a70a40269a14f210134a0d8d8a47247286",
     "provider_task_id": "819b8dd2-4cf9-42a8-85c3-b7993523eb47"
    },
    {
     "kind": "speech",
     "segment": "B-07",
     "speaker": "Student",
     "voice": "James",
     "start": 67.71927437641723,
     "end": 68.97315192743764,
     "text": "Do we need our headphones?",
     "source_mp3_sha256": "a088f64232cd4a05d95ba3d6796c6d904da8299c0cf9290aa636bc6dbe6c1f55",
     "provider_task_id": "54bed1d4-12ba-4941-8934-730111408eb3"
    },
    {
     "kind": "speech",
     "segment": "B-08",
     "speaker": "Assistant",
     "voice": "Paula",
     "start": 69.32312925170068,
     "end": 75.68539682539682,
     "text": "No, the room has headphones you can borrow. Each student must bring a memory card to save the recording.",
     "source_mp3_sha256": "5e0f7e4494214390292b676cc83bd06b546044f7935b428763f5af6771cf50af",
     "provider_task_id": "1b2309f3-0045-4403-9b82-46745809d511"
    },
    {
     "kind": "response_silence",
     "start": 75.68539682539682,
     "end": 90.68539682539682
    }
   ],
