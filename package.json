{
  "name": "g-brain-heist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "rename:usa-svg": "node scripts/rename-usa-svg.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test:clean": "rm -rf dist-tests",
    "test:build": "tsc --project tsconfig.tests.json",
    "test": "npm run test:clean && npm run test:build && NODE_ENV=test VITE_SUPABASE_URL=http://localhost VITE_SUPABASE_ANON_KEY=test node --test dist-tests/tests/*.js",
    "load:leaderboard": "k6 run load-tests/leaderboard.js",
    "load:shop": "k6 run load-tests/shop.js",
    "load:pvp": "k6 run load-tests/pvp.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "@tanstack/react-query": "^5.90.12",
    "fflate": "^0.8.2",
    "konva": "^10.0.12",
    "lottie-react": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.1",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vercel/node": "^5.5.15",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
