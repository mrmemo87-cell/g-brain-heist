{
  "name": "g-brain-heist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test:clean": "rm -rf dist-tests",
    "test:build": "tsc --project tsconfig.tests.json",
    "test": "npm run test:clean && npm run test:build && NODE_ENV=test VITE_SUPABASE_URL=http://localhost VITE_SUPABASE_ANON_KEY=test node --test dist-tests/tests/rpcGateway.test.js",
    "load:leaderboard": "k6 run load-tests/leaderboard.js",
    "load:shop": "k6 run load-tests/shop.js",
    "load:pvp": "k6 run load-tests/pvp.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "lottie-react": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
